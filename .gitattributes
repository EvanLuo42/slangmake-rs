# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Rust source files
*.rs text eol=lf

# Cargo files
Cargo.toml text eol=lf
Cargo.lock text eol=lf

# Config / scripts
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf

# Windows scripts — keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries — no line ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.so   binary
*.a    binary
*.lib  binary
*.rlib binary
*.wasm binary